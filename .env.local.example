# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# Te vinden in je Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Gedeeld reiswachtwoord -- e-mail/wachtwoord van een bestaand Supabase Auth-account.
# Server-only, nooit NEXT_PUBLIC_.
APP_LOGIN_EMAIL=trip@example.com
APP_LOGIN_PASSWORD=your-shared-password
